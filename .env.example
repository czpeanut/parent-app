# 與 student-app 同一個 Supabase 專案（值請在 Vercel 設定，不要 commit）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# student-app 網址（呼叫 /api/guardian/children），預設 https://codexstudy.com
STUDENT_APP_URL=https://codexstudy.com

# 綁定碼雜湊用，兩個專案（student-app、parent-app）必須設同一個值
GUARDIAN_CODE_PEPPER=

# Web Push（npm run vapid 產生）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@codexstudy.com

# 推播 worker 的共用密鑰（Supabase Database Webhook／pg_cron 帶在 x-notify-secret header）
NOTIFY_WEBHOOK_SECRET=
# （選用）Vercel Cron 用
CRON_SECRET=
